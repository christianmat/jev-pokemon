# Jev backend: "mock" (default, free, no key) or "gateway" (real Jev via Vercel AI Gateway)
JEV_MODE=mock
# Needed for JEV_MODE=gateway (or run `vercel env pull` to get VERCEL_OIDC_TOKEN)
AI_GATEWAY_API_KEY=
JEV_MODEL=typesafe-ai/jev

# Throttling: minimum gap between Jev calls, and a hard per-minute budget
JEV_MIN_INTERVAL_MS=300
JEV_MAX_PER_MIN=90

# Loop protection: sample alternatives after N decisions without progress. Optional: reload the last milestone checkpoint after M (off by default; it discards progress)
STUCK_EXPLORE=30
# STUCK_RELOAD=1000

PLAYER_NAME=JEV
RIVAL_NAME=BLUE
ROM_PATH=roms/red.gb

# Live stream (optional): YouTube stream key, or a full STREAM_URL (rtmp://… or a local .mkv for testing)
YOUTUBE_STREAM_KEY=
